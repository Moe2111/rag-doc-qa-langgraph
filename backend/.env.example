# Copy to backend/.env and fill in. backend/.env is gitignored; never commit secrets.
# DOCQA_ADAPTERS=memory runs everything offline with no keys.
DOCQA_ADAPTERS=live

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/docqa?sslmode=require

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docqa-v2

# Optional overrides; defaults live in src/docqa/settings.py
# DOCQA_WRITER_MODEL=claude-sonnet-5-5
# DOCQA_WRITER_EFFORT=medium
# DOCQA_SMALL_MODEL=claude-haiku-5-5
# DOCQA_DAILY_QUESTION_CAP=100
